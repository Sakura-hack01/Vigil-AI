{
  "title": "Fraud Detection Pipeline",
  "uid": "fraud-pipeline-v1",
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "🚨 Live Fraud Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "fraud_anomaly_rate * 100", "legendFormat": "Fraud Rate %"}],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 3},
              {"color": "red", "value": 7}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "⚡ Prediction Rate (TPS)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "rate(fraud_predictions_total[1m]) * 60", "legendFormat": "TPS"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 3,
      "title": "⏱ REST Latency P99",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.99, rate(fraud_prediction_latency_seconds_bucket{method='rest'}[5m])) * 1000", "legendFormat": "P99 ms"}],
      "fieldConfig": {"defaults": {"unit": "ms", "thresholds": {"steps": [{"color": "green","value": 0},{"color": "yellow","value": 25},{"color": "red","value": 50}]}}}
    },
    {
      "id": 4,
      "title": "⚡ Kafka Inference P99",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.99, rate(fraud_prediction_latency_seconds_bucket{method='kafka'}[5m])) * 1000", "legendFormat": "P99 ms"}],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 5,
      "title": "Fraud Rate Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "fraud_anomaly_rate * 100", "legendFormat": "Live Fraud Rate %"},
        {"expr": "0.02 * 100", "legendFormat": "Baseline (2%)"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 6,
      "title": "Prediction Latency Distribution",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(fraud_prediction_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, rate(fraud_prediction_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, rate(fraud_prediction_latency_seconds_bucket[5m])) * 1000", "legendFormat": "P99"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    },
    {
      "id": 7,
      "title": "Fraud Score Distribution",
      "type": "histogram",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "fraud_model_score_bucket", "legendFormat": "Score Bucket {{le}}"}]
    },
    {
      "id": 8,
      "title": "Predictions by Result",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by(result) (rate(fraud_predictions_total[5m]))", "legendFormat": "{{result}}"}
      ]
    },
    {
      "id": 9,
      "title": "Total Predictions (All Time)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 12},
      "targets": [{"expr": "sum(fraud_predictions_total)", "legendFormat": "Total"}]
    }
  ],
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "schemaVersion": 37
}
